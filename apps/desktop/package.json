{
  "name": "@domos/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Domos desktop",
  "author": "Domos",
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "build": "node build.mjs",
    "dev": "pnpm build && electron .",
    "test": "pnpm build && playwright test --config playwright.config.ts",
    "pack": "pnpm build && electron-builder --dir",
    "dist": "pnpm build && electron-builder"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/noto-sans-sc": "5.3.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@domos/agent": "workspace:*",
    "@domos/hosting": "workspace:*",
    "zod": "4.6.7",
    "@domos/ui": "workspace:*"
  },
  "devDependencies": {
    "@types/react-dom": "19.3.0",
    "@types/react": "19.3.0",
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2"
  },
  "build": {
    "appId": "app.domos.desktop",
    "productName": "Domos",
    "asar": true,
    "directories": {
      "buildResources": "../../packages/ui/assets",
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json",
      "!node_modules/**"
    ],
    "extraResources": [
      {
        "from": ".",
        "to": ".",
        "filter": [
          "runtime/**"
        ]
      }
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.productivity",
      "hardenedRuntime": true
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "../../packages/ui/assets/icon.ico"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Domos"
    }
  }
}
