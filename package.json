{
  "name": "domos",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "chat": "node --env-file-if-exists=.env apps/cli/src/main.ts",
    "start": "node --env-file-if-exists=.env apps/api/src/main.ts",
    "web": "pnpm --filter @domos/web dev",
    "build": "pnpm --filter @domos/web build",
    "test:e2e": "pnpm build && playwright test",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "biome check apps packages package.json domos.config.json tsconfig.json biome.json vitest.config.ts playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@biomejs/biome": "2.5.15",
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  }
}
